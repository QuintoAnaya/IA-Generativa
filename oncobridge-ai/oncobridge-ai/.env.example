# Copia este archivo a ".env" y pega tu API key real ahi (nunca en este archivo).
#
#   cp .env.example .env
#
# Conseguila gratis en: https://aistudio.google.com/app/apikey
#
# Si dejas esta variable vacia o no creas el .env, el sistema NO se rompe:
# corre automaticamente en "modo simulado" (ver oncobridge/utils/llm_client.py).
GEMINI_API_KEY=pega_tu_api_key_aca
